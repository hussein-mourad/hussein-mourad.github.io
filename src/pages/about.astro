---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = [
  'TypeScript',
  'React',
  'Next.js',
  'NestJS',
  'FastAPI',
  'Django',
  'Node.js',
  'Tailwind CSS',
  'PostgreSQL',
  'Docker',
  'AWS',
];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        I'm a fullstack software engineer with hands-on experience building scalable web applications
        using React, TypeScript, NestJS, FastAPI, and Docker. I've developed REST APIs, deployed
        cloud applications on AWS, and integrated AI-powered solutions.
      </p>
      <p>
        I enjoy turning ideas into clean, functional software and continuously learning modern
        technologies. When I'm not coding, you'll find me exploring new tools, contributing to open
        source, or diving into the latest in tech.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>
  </section>
</BaseLayout>
