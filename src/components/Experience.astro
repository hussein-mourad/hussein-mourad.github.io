---
const experience = [
  {
    period: 'Jan 2025 — Apr 2025',
    role: 'Fullstack Developer',
    place: 'Interaktiv · Remote',
    highlights: [
      'Built a Chrome extension for PDF document processing and analysis',
      'Designed and implemented scalable REST APIs using NestJS',
      'Integrated Amazon S3 for secure file storage',
      'Implemented real-time communication using Socket.IO',
      'Built asynchronous background jobs using BullMQ',
      'Containerized applications with Docker and deployed on AWS EC2',
      'Monitored infrastructure using Prometheus and Grafana',
      'Optimized FastAPI AI inference service for improved performance',
    ],
  },
  {
    period: 'Oct 2021 — Oct 2023',
    role: 'Software Engineer',
    place: 'MIA Robotics · Alexandria, Egypt',
    highlights: [
      'Developed software for autonomous robotic systems',
      'Configured and maintained Raspberry Pi devices for robot control',
      'Trained YOLO-based computer vision models for object detection',
      'Developed ROS-based applications for sensor and robotic component communication',
    ],
  },
  {
    period: '2019 — 2024',
    role: 'B.Eng. Computer & Communication',
    place: 'Faculty of Engineering, Alexandria University',
    highlights: [
      'Object-Oriented Programming, Algorithms & Data Structures',
      'Computer Architecture, Operating Systems, Database Systems',
      'Computer Security, Distributed Systems',
    ],
  },
];
---

<section id="experience" class="mx-auto max-w-3xl px-6 pb-20">
  <div class="border-line mb-8 flex items-baseline justify-between border-b pb-3">
    <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">Experience</h2>
  </div>

  <div class="border-line relative ml-3 border-l">
    {
      experience.map((item) => (
        <div class="relative mb-10 pl-8 last:mb-0">
          <span
            class="bg-signal absolute top-1.5 left-[-5px] h-2.5 w-2.5 rounded-full"
            aria-hidden="true"
          />
          <p class="text-ink-soft font-mono text-xs">{item.period}</p>
          <h3 class="font-display text-ink mt-1 text-lg font-medium">{item.role}</h3>
          <p class="text-ink-soft text-sm">{item.place}</p>
          <ul class="text-ink-soft mt-2 list-disc space-y-1 pl-4 text-sm">
            {item.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
