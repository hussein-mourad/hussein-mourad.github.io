---
const site = {
  name: "Hussein Mourad",
  tagline: "I build things for the web.",
  blurb: "I'm a software engineer focused on crafting fast, accessible, and delightful web experiences. Welcome to my little corner of the internet.",
  about: [
    "Hello! I'm Hussein Mourad. I enjoy turning ideas into clean, functional software. My journey into programming started with a curiosity about how things work, and it grew into a passion for building products that people love.",
    "When I'm not coding, you'll find me exploring new technologies, contributing to open source, or sipping coffee while reading about the latest in tech.",
  ],
  email: "hello@example.com",
  github: "https://github.com/hussein-mourad",
  linkedin: "https://linkedin.com/in/hussein-mourad",
};
---

<section id="hero" class="hero">
  <p class="hero__eyebrow">Hi, my name is</p>
  <h1 class="hero__name">{site.name}.</h1>
  <p class="hero__tagline">{site.tagline}</p>
  <p class="hero__blurb">{site.blurb}</p>
  <a class="btn" href="#projects">View my work</a>
</section>

<section id="about" class="section">
  <h2 class="section__title">About</h2>
  <div class="about">
    {site.about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
