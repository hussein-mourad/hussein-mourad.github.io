---
const skills = [
  {
    category: 'Languages',
    items: ['TypeScript', 'JavaScript', 'Python', 'Go', 'C/C++', 'SQL'],
  },
  {
    category: 'Frontend',
    items: ['React', 'Next.js', 'Tailwind CSS', 'Material UI', 'Shadcn UI'],
  },
  {
    category: 'Backend',
    items: ['NestJS', 'Express', 'FastAPI', 'Django', 'Flask', 'Node.js', 'Laravel'],
  },
  {
    category: 'Databases',
    items: ['PostgreSQL', 'MySQL', 'MongoDB', 'Redis'],
  },
  {
    category: 'Cloud & DevOps',
    items: ['Docker', 'AWS EC2', 'AWS S3', 'Git', 'GitHub Actions', 'Linux', 'Prometheus', 'Grafana'],
  },
  {
    category: 'Other',
    items: ['REST APIs', 'OAuth2', 'JWT', 'WebSockets', 'Drizzle ORM'],
  },
];
---

<section id="skills" class="mx-auto max-w-3xl px-6 pb-20">
  <div class="border-line mb-8 flex items-baseline justify-between border-b pb-3">
    <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">Skills</h2>
  </div>

  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((group) => (
        <div>
          <h3 class="font-display text-ink mb-3 text-sm font-medium">{group.category}</h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
